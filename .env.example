# Copy to .env and fill in. .env is git-ignored.

# GitLab personal access token with the `read_repository` scope.
GITLAB_TOKEN=

# Where the GitBook backup lives.
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=nylinary/gitbook-backup
GITLAB_REF=main
GITBOOK_FILE=it-database/questions.md

# Seconds before the markdown is re-downloaded (the ⟳ button forces a refresh).
CACHE_TTL=300
REQUEST_TIMEOUT=15
