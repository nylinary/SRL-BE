# Copy to .env and fill in. .env is git-ignored.

# GitLab personal access token with the `read_repository` scope.
GITLAB_TOKEN=

# Where the GitBook backup lives.
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=nylinary/gitbook-backup
GITLAB_REF=main
GITBOOK_FILE=it-database/questions.md

# Seconds before the markdown is re-downloaded (the ⟳ button forces a refresh).
CACHE_TTL=300
REQUEST_TIMEOUT=15

# Spaced repetition (FSRS).
# Storage: PostgreSQL is REQUIRED — review history lives here and the app refuses to
# start without it. The schema (progress, reviews, fsrs_params) is created automatically
# on first run.
DATABASE_URL=postgresql://user:password@host:5432/questions
# Target probability of recall FSRS schedules for (0.8–0.97). Higher = more frequent reviews.
FSRS_RETENTION=0.9
# Optional starting weights (21, comma-separated). Normally you don't set this — the
# Настройки tab trains weights on your history and stores them in the fsrs_params table,
# which takes precedence over this. Leave empty for the library defaults.
# FSRS_PARAMETERS=
# FSRS_MAX_INTERVAL=36500
# FSRS_ENABLE_FUZZ=true
