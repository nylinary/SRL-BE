# Copy to .env and fill in. .env is git-ignored.

# ============================ AUTH / MULTI-USER ============================
# Secret used to sign our session JWTs and the OAuth state token. REQUIRED.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=30

# Comma-separated emails that get admin rights (re-checked on every login).
ADMIN_EMAILS=you@example.com

# Public origins used to build OAuth redirect URIs and the post-login bounce.
# PUBLIC_BACKEND_URL is THIS API's origin; FRONTEND_URL is the SRL-FE origin.
PUBLIC_BACKEND_URL=https://gitbook-questions-repetition-production.up.railway.app
FRONTEND_URL=https://srl-fe-production.up.railway.app

# Anti-abuse: max new cards a user may create per rolling 24h (0 = unlimited).
DAILY_CARD_LIMIT=1000

# Social login. A provider appears on the login page only when BOTH its id+secret
# are set. Register each app with redirect URI: {PUBLIC_BACKEND_URL}/api/auth/<p>/callback
# Google  -> https://console.cloud.google.com/apis/credentials  (OAuth client, Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub  -> https://github.com/settings/developers  (OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Yandex  -> https://oauth.yandex.com/client/new  (scopes: login:email, login:info)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ============================ GITBOOK (/asset only) ============================
# The GitBook importer is removed; these remain so images in already-imported cards
# (served via /asset) still load. Safe to leave blank if you have no such images.
GITLAB_TOKEN=

GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=nylinary/gitbook-backup
GITLAB_REF=main
GITBOOK_FILE=it-database/questions.md

# Seconds before the markdown is re-downloaded (the ⟳ button forces a refresh).
CACHE_TTL=300
REQUEST_TIMEOUT=15

# CORS — origins allowed to call this API (the SRL-FE frontend). Comma-separated,
# or * for any. e.g. https://srl.example.com
CORS_ORIGINS=*

# Spaced repetition (FSRS).
# Storage: PostgreSQL is REQUIRED — review history lives here and the app refuses to
# start without it. The schema (cards, progress, reviews, fsrs_params) is created
# automatically on first run.
DATABASE_URL=postgresql://user:password@host:5432/questions
# Target probability of recall FSRS schedules for (0.8–0.97). Higher = more frequent reviews.
FSRS_RETENTION=0.9
# Optional starting weights (21, comma-separated). Normally you don't set this — the
# Настройки tab trains weights on your history and stores them in the fsrs_params table,
# which takes precedence over this. Leave empty for the library defaults.
# FSRS_PARAMETERS=
# FSRS_MAX_INTERVAL=36500
# FSRS_ENABLE_FUZZ=true
